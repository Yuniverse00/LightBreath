<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorLightBlue"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.main.ChatFragment">

    <View
        android:id="@+id/bkground_chat"
        android:layout_width="wrap_content"
        android:layout_height="90dp"
        android:background="@color/colorBlue1"
        android:paddingTop="3dp"
        tools:ignore="MissingConstraints" />
    <View
        android:id="@+id/bkgroundline_chat"
        android:layout_width="wrap_content"
        android:layout_height="3dp"
        android:layout_below="@id/bkground_chat"
        android:background="@color/colorBlue2"
        tools:ignore="MissingConstraints" />
    <Space
        android:id="@+id/space_img"
        android:layout_width="15dp"
        android:layout_height="1.5dp"
        app:layout_constraintLeft_toLeftOf="parent" />
    <Space
        android:id="@+id/space_img1"
        android:layout_width="1.5dp"
        android:layout_height="7.5dp"
        app:layout_constraintTop_toTopOf="parent" />

    <Space
        android:id="@+id/space_right"
        android:layout_width="22.5dp"
        android:layout_height="1.5dp"
        app:layout_constraintRight_toRightOf="parent" />


    <TextView
        android:id="@+id/chat_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="  Chat"
        android:textSize="38.25sp"
        android:textStyle="bold"
        android:textColor="@color/colorWhite"
        app:layout_constraintLeft_toRightOf="@+id/chat_img"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toBottomOf="@+id/chat_img" />
    <ImageView
        android:id="@+id/alarm_ic"
        android:layout_width="63dp"
        android:layout_height="63dp"
        app:srcCompat="@drawable/chat"
        app:layout_constraintRight_toLeftOf="@+id/chat_text"
        app:layout_constraintBottom_toBottomOf="@+id/chat_img"
        app:layout_constraintTop_toTopOf="parent" />
    <ImageView
        android:id="@+id/chat_img"
        android:layout_width="75dp"
        android:layout_height="75dp"
        app:srcCompat="@drawable/logo_header"
        app:layout_constraintTop_toBottomOf="@+id/space_img1"
        app:layout_constraintLeft_toRightOf="@id/space_img"
        tools:ignore="ContentDescription" />
    <ImageView
        android:id="@+id/home_ic"
        android:layout_width="63dp"
        android:layout_height="63dp"
        app:srcCompat="@drawable/home"
        app:layout_constraintRight_toLeftOf="@+id/space_right"
        app:layout_constraintBottom_toBottomOf="@+id/chat_img"
        app:layout_constraintTop_toTopOf="parent" />


    <RelativeLayout
        android:id="@id/message"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintLeft_toRightOf="@id/space_img"
        app:layout_constraintTop_toBottomOf="@id/bkground_chat"
        app:layout_constraintRight_toLeftOf="@+id/space_right"
        app:layout_constraintBottom_toBottomOf="parent">

        <ListView
            android:id="@+id/messageListView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/btnSendMessage"
            android:background="@color/colorWhite"

            android:divider="@color/colorWhite"
            android:dividerHeight="0dp"
            android:stackFromBottom="true"
            android:transcriptMode="alwaysScroll" />

        <EditText
            android:id="@+id/txtMessageContent"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@color/colorWhite"
            android:hint="Enter your message"
            android:layout_alignParentBottom="true"
            android:layout_toLeftOf="@id/btnSendMessage" />

        <ImageView
            android:id="@+id/btnSendMessage"
            android:layout_width="63dp"
            android:layout_height="63dp"
            app:srcCompat="@drawable/send_icon1"
            android:layout_alignParentBottom="true"
            android:layout_alignParentRight="true" />

    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
