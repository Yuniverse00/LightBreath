<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <View
            android:id="@+id/bkground_alarm1"
            android:layout_width="wrap_content"
            android:layout_height="90dp"
            android:background="@color/colorBlue1"
            android:paddingTop="3dp"
            tools:ignore="MissingConstraints" />

        <View
            android:id="@+id/bkgroundline_alarm1"
            android:layout_width="wrap_content"
            android:layout_height="3dp"
            app:layout_constraintBottom_toBottomOf="@id/bkground_alarm1"
            android:background="@color/colorBlue2"
            tools:ignore="MissingConstraints" />

        <Space
            android:id="@+id/space_img"
            android:layout_width="15dp"
            android:layout_height="1dp"
            app:layout_constraintLeft_toLeftOf="parent" />

        <Space
            android:id="@+id/space_img1"
            android:layout_width="1dp"
            android:layout_height="22.5dp"
            app:layout_constraintTop_toTopOf="parent" />

        <Space
            android:id="@+id/space_img_t"
            android:layout_width="1dp"
            android:layout_height="15dp"
            app:layout_constraintTop_toTopOf="parent" />

        <Space
            android:id="@+id/space_right"
            android:layout_width="15dp"
            android:layout_height="1dp"
            app:layout_constraintRight_toRightOf="parent" />

        <ImageView
            android:id="@+id/stats_ic"
            android:layout_width="63dp"
            android:layout_height="63dp"
            app:srcCompat="@drawable/reminder"
            app:layout_constraintRight_toLeftOf="@+id/fragment_createalarm_scheduleAlarmHeading"
            app:layout_constraintBottom_toBottomOf="@+id/alarm_icon1"
            app:layout_constraintTop_toBottomOf="@+id/space_img_t" />

        <ImageView
            android:id="@+id/alarm_icon1"
            android:layout_width="55.5dp"
            android:layout_height="45dp"
            app:srcCompat="@drawable/backarr"
            app:layout_constraintTop_toBottomOf="@+id/space_img1"
            app:layout_constraintLeft_toRightOf="@id/space_img"
            tools:ignore="ContentDescription" />

        <ImageView
            android:id="@+id/home_icon"
            android:layout_width="60dp"
            android:layout_height="60dp"
            app:layout_constraintBottom_toBottomOf="@+id/fragment_createalarm_scheduleAlarmHeading"
            app:layout_constraintRight_toLeftOf="@id/space_right"
            app:srcCompat="@drawable/logo_header" />

        <TextView
            android:id="@+id/fragment_createalarm_scheduleAlarmHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Reminder"
            android:textSize="52.5sp"
            android:textStyle="bold"
            android:textColor="@color/colorWhite"
            app:layout_constraintLeft_toRightOf="@+id/alarm_icon1"
            app:layout_constraintTop_toBottomOf="@+id/space_img_t"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintBottom_toBottomOf="@+id/alarm_icon1" />

        <TextView
            android:id="@+id/reminder_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="15dp"
            android:text="Reminder Time:"
            android:textSize="31.5sp"
            android:textColor="#000000"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@+id/fragment_createalarm_title"
            app:layout_constraintLeft_toLeftOf="@+id/alarm_name" />

        <TimePicker
            android:id="@+id/fragment_createalarm_timePicker"
            android:layout_width="0dp"
            android:background="#EEEEEE"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:timePickerMode="spinner"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/reminder_time" />

        <TextView
            android:id="@+id/reminder_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="15dp"
            android:text="Reminder Date:"
            android:textSize="31.5sp"
            android:textColor="#000000"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/fragment_createalarm_timePicker"
            app:layout_constraintLeft_toLeftOf="@+id/alarm_name" />

        <DatePicker
            android:id="@+id/fragment_createalarm_datePicker"
            android:layout_width="0dp"
            android:background="#EEEEEE"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:calendarViewShown="false"
            android:datePickerMode="spinner"
            app:layout_constraintRight_toRightOf="@id/fragment_createalarm_timePicker"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/reminder_date" />

        <TextView
            android:id="@+id/alarm_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Reminder name: "
            android:textSize="31.5sp"
            android:layout_marginLeft="30dp"
            android:textColor="#000000"
            android:textStyle="bold"
            android:layout_marginTop="45dp"
            app:layout_constraintTop_toBottomOf="@+id/bkgroundline_alarm1"
            app:layout_constraintLeft_toRightOf="@id/space_img" />

        <EditText
            android:id="@+id/fragment_createalarm_title"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginRight="45dp"
            android:layout_marginLeft="45dp"
            android:hint="   type name"
            android:background="@drawable/et_custom"
            app:layout_constraintTop_toBottomOf="@+id/alarm_name"
            app:layout_constraintRight_toRightOf="parent" />

        <CheckBox
            android:id="@+id/fragment_createalarm_recurring"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Remind Daily:"
            android:textSize="31.5sp"
            android:textColor="#000000"
            android:textStyle="bold"
            android:button="@null"
            android:drawableRight="?android:attr/listChoiceIndicatorMultiple"
            app:layout_constraintLeft_toLeftOf="@+id/alarm_name"
            app:layout_constraintTop_toBottomOf="@+id/fragment_createalarm_datePicker" />

        <ImageView
            app:srcCompat="@drawable/alarm_cancel"
            android:id="@+id/fragment_createalarm_cancelAlarm"
            android:layout_width="225dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="930dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@id/fragment_createalarm_scheduleAlarm" />

        <ImageView
            app:srcCompat="@drawable/alarm_save"
            android:id="@+id/fragment_createalarm_scheduleAlarm"
            android:layout_width="225dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Save Changes"
            android:textSize="25.5sp"
            android:textColor="@color/colorWhite"
            app:layout_constraintTop_toTopOf="@id/fragment_createalarm_cancelAlarm"
            app:layout_constraintBottom_toBottomOf="@id/fragment_createalarm_cancelAlarm"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintLeft_toRightOf="@id/fragment_createalarm_cancelAlarm" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>
