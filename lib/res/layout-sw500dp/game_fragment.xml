<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:background="@color/colorLightBlue"
    android:layout_height="match_parent"
    tools:context=".ui.main.GameFragment">

    <View
        android:id="@+id/bkground_game"
        android:layout_width="wrap_content"
        android:layout_height="90dp"
        android:background="@color/colorBlue1"
        android:paddingTop="3dp"
        tools:ignore="MissingConstraints" />
    <View
        android:id="@+id/bkgroundline_game"
        android:layout_width="wrap_content"
        android:layout_height="3dp"
        app:layout_constraintBottom_toBottomOf="@id/bkground_game"
        android:background="@color/colorBlue2"
        tools:ignore="MissingConstraints" />

    <Space
        android:id="@+id/space_img"
        android:layout_width="15dp"
        android:layout_height="1.5dp"
        app:layout_constraintLeft_toLeftOf="parent" />
    <Space
        android:id="@+id/space_img1"
        android:layout_width="1.5dp"
        android:layout_height="22.5dp"
        app:layout_constraintTop_toTopOf="parent" />
    <Space
        android:id="@+id/space_img_t"
        android:layout_width="1.5dp"
        android:layout_height="15dp"
        app:layout_constraintTop_toTopOf="parent" />
    <Space
        android:id="@+id/space_right"
        android:layout_width="15dp"
        android:layout_height="1.5dp"
        app:layout_constraintRight_toRightOf="parent" />
    <ImageView
        android:id="@+id/home_icon"
        android:layout_width="60dp"
        android:layout_height="60dp"
        app:layout_constraintBottom_toBottomOf="@+id/game_text"
        app:layout_constraintRight_toLeftOf="@id/space_right"
        app:srcCompat="@drawable/logo_header" />
    <ImageView
        android:id="@+id/game_img"
        android:layout_width="55.5dp"
        android:layout_height="45dp"
        app:srcCompat="@drawable/backarr"
        app:layout_constraintTop_toBottomOf="@+id/space_img1"
        app:layout_constraintLeft_toRightOf="@id/space_img"
        tools:ignore="MissingConstraints" />

    <ImageView
        android:id="@+id/stats_ic"
        android:layout_width="63dp"
        android:layout_height="63dp"
        app:srcCompat="@drawable/game"
        app:layout_constraintRight_toLeftOf="@+id/game_text"
        app:layout_constraintTop_toBottomOf="@+id/space_img_t"/>

    <TextView
        android:id="@+id/game_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Games"
        android:textSize="52.5dp"
        android:textStyle="bold"
        android:textColor="@color/colorWhite"
        app:layout_constraintLeft_toRightOf="@+id/game_img"
        app:layout_constraintTop_toBottomOf="@+id/space_img_t"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toBottomOf="@+id/game_img" />

    <ImageView
        android:id="@+id/home_ic"
        android:layout_width="63dp"
        android:layout_height="63dp"
        app:srcCompat="@drawable/home"
        android:visibility="gone"
        app:layout_constraintRight_toLeftOf="@id/space_right"
        app:layout_constraintBottom_toBottomOf="@+id/game_img"
        app:layout_constraintTop_toTopOf="parent" />
    <Space
        android:id="@+id/space1_game"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        app:layout_constraintTop_toBottomOf="@+id/bkground_game"/>

    <ListView
        android:background="@color/colorWhite"
        android:id="@+id/setting_selections"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="30dp"
        android:layout_marginRight="30dp"
        android:textColor="#000000"
        app:layout_constraintTop_toBottomOf="@+id/space1_game"/>
    <Space
        android:id="@+id/space2_game"
        android:layout_width="match_parent"
        android:layout_height="7.5dp"
        app:layout_constraintTop_toBottomOf="@+id/setting_selections"/>
    <TextView
        android:id="@+id/game_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/game_tips"
        android:textSize="24dp"
        android:visibility="gone"
        android:textStyle="bold"
        android:textColor="@color/colorBlue1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/space2_game"
        app:layout_constraintRight_toRightOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
