<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:background="@color/colorLightBlue"
    android:layout_height="match_parent">
    <View
        android:id = "@+id/bkground_alarm"
        android:layout_width="wrap_content"
        android:layout_height="60dp"
        android:background="@color/colorBlue1"
        android:paddingTop="2dp"
        tools:ignore="MissingConstraints" />
    <View
        android:id = "@+id/bkgroundline_alarm"
        android:layout_width="wrap_content"
        android:layout_height="2dp"
        app:layout_constraintBottom_toBottomOf = "@id/bkground_alarm"
        android:background="@color/colorBlue2"
        tools:ignore="MissingConstraints" />
    <Space
        android:id="@+id/space_img"
        android:layout_width="10dp"
        android:layout_height="1dp"
        app:layout_constraintLeft_toLeftOf="parent" />
    <Space
        android:id="@+id/space_img1"
        android:layout_width="1dp"
        android:layout_height="15dp"
        app:layout_constraintTop_toTopOf="parent" />
    <Space
        android:id="@+id/space_img_t"
        android:layout_width="1dp"
        android:layout_height="10dp"
        app:layout_constraintTop_toTopOf="parent" />
    <Space
        android:id="@+id/space_right"
        android:layout_width="10dp"
        android:layout_height="1dp"
        app:layout_constraintRight_toRightOf="parent" />
    <ImageView
        android:id="@+id/home_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:layout_constraintBottom_toBottomOf="@+id/alarm_text"
        app:layout_constraintRight_toLeftOf="@id/space_right"
        app:srcCompat="@drawable/logo_header" />
    <ImageView
        android:id="@+id/alarm_icon"
        android:layout_width="37dp"
        android:layout_height="30dp"
        app:layout_constraintLeft_toRightOf="@id/space_img"
        app:layout_constraintTop_toBottomOf="@+id/space_img1"
        app:srcCompat="@drawable/backarr"
        tools:ignore="ContentDescription" />
    <ImageView
        android:id="@+id/alarm_ic"
        android:layout_width="42dp"
        android:layout_height="42dp"
        app:srcCompat="@drawable/reminder"
        app:layout_constraintRight_toLeftOf="@+id/alarm_text"
        app:layout_constraintBottom_toBottomOf="@+id/alarm_icon"
        app:layout_constraintTop_toBottomOf="@+id/space_img_t" />
    <TextView
        android:id="@+id/alarm_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reminders"
        android:textSize="35dp"
        android:textStyle="bold"
        android:textColor="@color/colorWhite"
        app:layout_constraintLeft_toRightOf="@+id/alarm_icon"
        app:layout_constraintTop_toBottomOf="@+id/space_img_t"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toBottomOf="@+id/alarm_icon"/>

    <ImageView
        android:id="@+id/home_ic"
        android:layout_width="42dp"
        android:layout_height="42dp"
        app:srcCompat="@drawable/home"
        android:visibility="gone"
        app:layout_constraintRight_toLeftOf="@+id/space_right"
        app:layout_constraintBottom_toBottomOf="@+id/alarm_icon"
        app:layout_constraintTop_toTopOf="parent" />
    <Space
        android:id="@+id/space1"
        android:layout_width="match_parent"
        android:layout_height="15dp"
        app:layout_constraintTop_toBottomOf="@+id/bkgroundline_alarm"/>

    <ImageView
        android:id="@+id/fragment_listalarms_addAlarm"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:textSize="17dp"
        app:srcCompat="@drawable/addreminder"
        android:textColor="@color/colorWhite"
        android:layout_marginBottom="20dp"
        android:layout_marginRight="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/fragment_listalarms_recylerView"
        android:background="@color/colorWhite"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/space1"
        app:layout_constraintBottom_toTopOf="@id/fragment_listalarms_addAlarm"
        />
</androidx.constraintlayout.widget.ConstraintLayout>