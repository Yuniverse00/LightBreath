<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/colorLightBlue"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id = "@+id/bkground"
        android:layout_width="wrap_content"
        android:layout_height="60dp"
        android:background="@color/colorBlue1"
        android:paddingTop="2dp"
        tools:ignore="MissingConstraints" />

    <View
        android:id = "@+id/chartback"
        android:layout_width="30dp"
        android:layout_height="wrap_content"
        android:background="@color/colorWhite"
        app:layout_constraintTop_toBottomOf = "@id/space3"
        android:paddingTop="2dp"
        tools:ignore="MissingConstraints" />

    <View
        android:id = "@+id/bkgroundline"
        android:layout_width="wrap_content"
        android:layout_height="2dp"
        app:layout_constraintBottom_toBottomOf = "@id/bkground"
        android:background="@color/colorBlue2"
        tools:ignore="MissingConstraints" />
    <Space
        android:id="@+id/space_img"
        android:layout_width="10dp"
        android:layout_height="1dp"
        app:layout_constraintLeft_toLeftOf="parent" />
    <Space
        android:id="@+id/space_img1"
        android:layout_width="1dp"
        android:layout_height="15dp"
        app:layout_constraintTop_toTopOf="parent" />
    <Space
        android:id="@+id/space_img_t"
        android:layout_width="1dp"
        android:layout_height="10dp"
        app:layout_constraintTop_toTopOf="parent" />
    <Space
        android:id="@+id/space_right"
        android:layout_width="10dp"
        android:layout_height="1dp"
        app:layout_constraintRight_toRightOf="parent" />
    <ImageView
        android:id="@+id/home_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="10dp"
        app:layout_constraintRight_toLeftOf="@id/space_right"
        app:srcCompat="@drawable/logo_header" />
    <ImageView
        android:id="@+id/stats_icon"
        android:layout_width="37dp"
        android:layout_height="30dp"
        app:srcCompat="@drawable/backarr"
        app:layout_constraintTop_toBottomOf="@+id/space_img1"
        app:layout_constraintLeft_toRightOf="@id/space_img"/>
    <ImageView
        android:id="@+id/stats_ic"
        android:layout_width="42dp"
        android:layout_height="42dp"
        app:srcCompat="@drawable/stats"
        android:layout_marginTop="5dp"
        app:layout_constraintRight_toLeftOf="@+id/stats_text"
        app:layout_constraintTop_toTopOf="parent"
         />
    <TextView
        android:id="@+id/stats_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=" My Smoking Trends"
        android:textSize="25dp"
        android:textStyle="bold"
        android:textColor="@color/colorWhite"
        app:layout_constraintLeft_toRightOf="@+id/stats_icon"
        app:layout_constraintTop_toBottomOf="@+id/space_img_t"
        app:layout_constraintBottom_toBottomOf="@+id/stats_icon"
        app:layout_constraintRight_toRightOf="parent"/>
    <ImageView
        android:id="@+id/home_ic"
        android:layout_width="42dp"
        android:layout_height="42dp"
        app:srcCompat="@drawable/home"
        android:visibility="gone"
        app:layout_constraintRight_toLeftOf="@+id/space_right_icon"
        app:layout_constraintBottom_toBottomOf="@+id/stats_icon"
        app:layout_constraintTop_toTopOf="parent" />
    <Space
        android:id="@+id/space1"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        app:layout_constraintTop_toBottomOf="@+id/bkground"/>

    <TextView
        android:id="@+id/stats_today"
        android:gravity="center"
        android:layout_width="0dp"
        android:text = "Today"
        android:textColor="#FFFFFF"
        android:background="@color/colorBlue1"
        android:textStyle="bold"
        android:textSize="20dp"
        app:layout_constraintTop_toBottomOf="@+id/space1"
        app:layout_constraintLeft_toLeftOf="@id/stats_daily_table"
        app:layout_constraintRight_toRightOf="@id/stats_daily_table"
        android:layout_height="wrap_content"/>

    <TableLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stretchColumns="1"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        app:layout_constraintTop_toBottomOf="@+id/stats_today"
        android:id="@+id/stats_daily_table">
        <TableRow
            android:background="#000000">
            <TextView
                android:layout_column="1"
                android:text="    Smoked in Total (Cigarettes)"
                android:layout_marginTop="0dp"
                android:layout_marginRight="0dp"
                android:layout_marginLeft="0dp"
                android:background="#FFFFFF"/>
            <TextView
                android:id="@+id/today_smoke_total"
                android:text="0    "
                android:layout_width="60dp"
                android:gravity="right"
                android:layout_marginTop="0dp"
                android:layout_marginRight="0dp"
                android:background="#FFFFFF"/>
        </TableRow>
        <TableRow
            android:background="#000000">
            <TextView
                android:layout_column="1"
                android:text="    Total Cash Spent"
                android:layout_marginTop="1dp"
                android:layout_marginRight="0dp"
                android:layout_marginLeft="0dp"
                android:background="#FFFFFF"/>
            <TextView
                android:id="@+id/today_cash_total"
                android:text="$0.00   "
                android:stretchColumns="3"
                android:gravity="right"
                android:layout_marginTop="1dp"
                android:layout_marginRight="0dp"
                android:background="#FFFFFF"/>
        </TableRow>
        <TableRow
            android:background="#000000">
            <TextView
                android:layout_column="1"
                android:text="    Amount of time since you smoked"
                android:layout_marginTop="1dp"
                android:layout_marginRight="0dp"
                android:layout_marginLeft="0dp"
                android:layout_marginBottom="0dp"
                android:background="#FFFFFF"/>
            <TextView
                android:id="@+id/today_since_last"
                android:text="0min   "
                android:stretchColumns="3"
                android:gravity="right"
                android:layout_marginTop="1dp"
                android:layout_marginRight="0dp"
                android:layout_marginBottom="0dp"
                android:background="#FFFFFF"/>
        </TableRow>

    </TableLayout>

    <TextView
        android:id="@+id/stats_weekly"
        android:gravity="center"
        android:layout_width="0dp"
        android:text = "This Week"
        android:textColor="#FFFFFF"
        android:background="@color/colorBlue1"
        android:textStyle="bold"
        android:textSize="20dp"
        app:layout_constraintLeft_toLeftOf="@id/stats_daily_table"
        app:layout_constraintRight_toRightOf="@id/stats_daily_table"
        app:layout_constraintTop_toBottomOf="@+id/stats_daily_table"
        android:layout_height="wrap_content"/>

    <TableLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stretchColumns="1"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        app:layout_constraintTop_toBottomOf="@+id/stats_weekly"
        android:id="@+id/stats_weekly_table">
        <TableRow
            android:background="#000000">
            <TextView
                android:layout_column="1"
                android:text="    Smoked in Total (Cigarettes)"
                android:layout_marginTop="0dp"
                android:layout_marginRight="0dp"
                android:layout_marginLeft="0dp"
                android:background="#FFFFFF"/>
            <TextView
                android:id="@+id/week_smoke_total"
                android:text="0    "
                android:layout_width="60dp"
                android:gravity="right"
                android:layout_marginTop="0dp"
                android:layout_marginRight="0dp"
                android:background="#FFFFFF"/>
        </TableRow>
        <TableRow
            android:background="#000000">
            <TextView
                android:layout_column="1"
                android:text="    Total Cash Spent"
                android:layout_marginTop="1dp"
                android:layout_marginRight="0dp"
                android:layout_marginLeft="0dp"
                android:background="#FFFFFF"/>
            <TextView
                android:id="@+id/week_cash_total"
                android:text="$0.00   "
                android:stretchColumns="3"
                android:gravity="right"
                android:layout_marginTop="1dp"
                android:layout_marginRight="0dp"
                android:layout_marginBottom="0dp"
                android:background="#FFFFFF"/>
        </TableRow>
        <TableRow
            android:background="#000000">
            <TextView
                android:layout_column="1"
                android:text=""
                android:layout_marginTop="1dp"
                android:layout_marginRight="0dp"
                android:layout_marginLeft="0dp"
                android:background="#FFFFFF"/>
            <TextView
                android:layout_column="1"
                android:text=""
                android:layout_marginTop="1dp"
                android:layout_marginRight="0dp"
                android:layout_marginLeft="0dp"
                android:background="#FFFFFF"/>
        </TableRow>
        <TableRow
            android:background="#FFFFFF">
            <TextView
                android:layout_column="1"
                android:text=""
                android:layout_marginTop="1dp"
                android:layout_marginRight="0dp"
                android:layout_marginLeft="0dp"
                android:background="#FFFFFF"/>
            <TextView
                android:layout_column="1"
                android:text=""
                android:layout_marginTop="1dp"
                android:layout_marginRight="0dp"
                android:layout_marginLeft="0dp"
                android:background="#FFFFFF"/>
        </TableRow>
    </TableLayout>
    <ImageView
        android:id="@+id/edit_smoking_history"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:text = "Start Smoking"
        android:src="@drawable/editsmokinghistory"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/space6"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <Space
        android:id="@+id/space6"
        android:layout_width="match_parent"
        android:layout_height="15dp"
        app:layout_constraintTop_toBottomOf="@+id/stats_weekly_table"/>

    <ImageView
        android:id="@+id/self_report_button"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:text = "Start Smoking"
        app:layout_constraintTop_toBottomOf="@+id/space6"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>

    <Space
        android:id="@+id/space7"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        app:layout_constraintTop_toBottomOf="@+id/self_report_button"/>
    <Space
        android:id="@+id/space_right_icon"
        android:layout_width="15dp"
        android:layout_height="1dp"
        app:layout_constraintRight_toRightOf="parent" />
    <Button
        android:id="@+id/daily_trend_button"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:text="Smoking"
        android:onClick="daily_trend_chart"
        android:background="@drawable/btn_custom3"
        android:layout_marginRight="5dp"
        android:layout_marginLeft="40dp"
        app:layout_constraintTop_toBottomOf="@+id/space7"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/cash_spent_button"/>
    <Button
        android:id="@+id/cash_spent_button"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:text="@string/Stats_chartCash"
        android:onClick="cash_spent_chart"
        android:layout_marginLeft="5dp"
        android:layout_marginRight="40dp"
        android:background="@drawable/btn_custom2"
        app:layout_constraintTop_toBottomOf="@+id/space7"
        app:layout_constraintLeft_toRightOf="@+id/daily_trend_button"
        app:layout_constraintRight_toRightOf="parent"/>
    <Space
        android:id="@+id/space3"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        app:layout_constraintTop_toBottomOf="@+id/daily_trend_button"/>




    <TextView
        android:id="@+id/xaxis_title"
        android:gravity="center"
        android:textStyle="bold"
        android:textColor="#000000"
        android:background="@color/colorWhite"
        android:text="Days of the Week"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        android:paddingBottom="5dp"
        android:paddingLeft="45dp"
        android:paddingRight="17dp"
        />


    <ImageView
        android:id="@+id/table_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:srcCompat="@drawable/bar_dollars"
        android:paddingLeft = "10dp"
        android:paddingTop="90dp"
        app:layout_constraintLeft_toLeftOf="@+id/chartback"
        app:layout_constraintTop_toBottomOf="@+id/space3" />
    <com.github.mikephil.charting.charts.BarChart
        android:id="@+id/barChart"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/colorWhite"
        app:layout_constraintTop_toBottomOf="@id/space3"
        app:layout_constraintBottom_toTopOf="@id/xaxis_title"
        app:layout_constraintLeft_toRightOf="@+id/chartback"
        app:layout_constraintRight_toRightOf="parent"
        />

    <ImageView
        android:id="@+id/arrow_left"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginLeft="45dp"
        android:layout_marginBottom="5dp"
        app:srcCompat="@drawable/arrowleft"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <ImageView
        android:id="@+id/arrow_right"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginRight="17dp"
        android:layout_marginBottom="5dp"
        app:srcCompat="@drawable/arrowright"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>